# Backend API URL (Cloud Run)
NEXT_PUBLIC_API_URL=https://your-backend.run.app/api

# Supabase (public anon key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IPPEO 웹훅 테스트 페이지 (/admin/webhook-test) 전용
# 실제 운영 IPPEO 콜백은 백엔드 env(IPPEO_API_KEY, IPPEO_WEBHOOK_SECRET)에서만 사용
# 이 변수들은 관리자 테스트 페이지에서만 쓰이며, 빌드 시 클라이언트 번들에 노출되므로
# 운영 환경에서 테스트 페이지 사용을 원하지 않으면 비워두어도 무방
NEXT_PUBLIC_IPPEO_API_KEY=
NEXT_PUBLIC_IPPEO_WEBHOOK_SECRET=
